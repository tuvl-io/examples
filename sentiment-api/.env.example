# Safe to commit — placeholder values only.
# Copy to .env and fill in real values. .env is git-ignored; never commit secrets.

# --- PostgreSQL (database: tuvl_reviews) ---
# The datasource (datasources/postgres.yaml) reads these individual vars.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tuvl_reviews
POSTGRES_USER=tuvl
POSTGRES_PASSWORD=your-postgres-password

# LLM — Google Gemini via LiteLLM (gemini/gemini-3.1-flash-lite)
# Used by the `classify` Agent step (llms/default.yaml).
GEMINI_API_KEY=your-gemini-api-key

# --- Production (required by `tuvl run` / the shipped container) ---
# Generate with: tuvl keys generate
# `tuvl run` refuses to boot without a persistent signing key.
TUVL_BISCUIT_PRIVATE_KEY=your-biscuit-private-key

# --- Optional ---
TUVL_TELEMETRY_ENABLED=false
