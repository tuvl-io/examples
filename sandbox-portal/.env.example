# tuvl sandbox portal — config template. Copy to .env (git-ignored) and fill in.
PORTAL_HOST=try.tuvl.online
BASE_DOMAIN=tuvl.online
SANDBOX_SCHEME=https
TTL_MINUTES=20
SLOT_COUNT=12
MAX_PER_SESSION=2
SANDBOX_MEM_MB=512
# LLM for the example workflows (degrades gracefully if unset/quota'd)
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
