# tuvl sandbox portal — config template. Copy to .env (git-ignored) and fill in.
PORTAL_HOST=try.tuvl.online
BASE_DOMAIN=tuvl.online
SANDBOX_SCHEME=https
TTL_MINUTES=20
SLOT_COUNT=12
MAX_PER_SESSION=2
SANDBOX_MEM_MB=512
# LLM for the example workflows (degrades gracefully if unset/quota'd)
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=

# Admin dashboard at /admin on the portal host: Google sign-in, one allowed email.
# Create an OAuth client (type "Web application") in Google Cloud and add the redirect URI
#   https://try.tuvl.online/admin/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAIL=sooraj@tuvl.io
# long random string; signs the admin cookie (sessions end when it changes)
ADMIN_SESSION_SECRET=
