# Safe to commit. Real secrets live in .env (git-ignored). Never commit .env.
# Copy to .env and fill in real values:  cp .env.example .env

# ── PostgreSQL (database tuvl_kyc; pgvector extension required) ───────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tuvl_kyc
POSTGRES_USER=tuvl
POSTGRES_PASSWORD=your-postgres-password

# ── LLM — Google Gemini via LiteLLM (chat model `default` + judge model `judge`) ──
# Required by the investigate/assess steps, the fail-closed supervisor judge,
# and the `tuvl test` judge evaluations.
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_CLOUD_PROJECT=712961387019

# ── `tuvl test` judge model (used when an evaluation has no per-eval judge_model)
# Any LiteLLM model string, e.g. gemini/gemini-3.1-flash-lite. Empty = evaluations
# are skipped (a skipped evaluation counts as a failure).
TUVL_TEST_JUDGE=gemini/gemini-3.1-flash-lite

# ── Sanctions / registry screening API (stubbed by design) ───────────────────
# Both sanctions_screen and the fetch_registry tool POST to a public echo
# endpoint so the demo runs with no real provider. NOTE: an APICall `url` is
# {{context}}-templated only (not env-substituted), so the workflow hardcodes
# this URL — this var is documentation for when you swap in a real provider.
SCREENING_API_URL=https://postman-echo.com/post

# ── Production only (HITL group-gate drills / `tuvl run`) ─────────────────────
# Generate with `tuvl keys generate`. Not needed for `tuvl dev`.
# TUVL_BISCUIT_PRIVATE_KEY=
