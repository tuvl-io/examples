# Safe to commit — placeholders only. Copy to .env and fill in real values.
# .env is git-ignored (see .gitignore).

# ── PostgreSQL (must have the pgvector extension — see README/REQUIREMENTS) ──
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tuvl_kb
POSTGRES_USER=tuvl
POSTGRES_PASSWORD=your-postgres-password

# ── LLM — Google Gemini via LiteLLM (chat gemini/gemini-3.1-flash-lite + embeddings gemini/gemini-embedding-001 @ 1536 dims) ──
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_CLOUD_PROJECT=712961387019

# ── Optional: override the base URL the client/ask.ts demo targets ──
TUVL_BASE_URL=http://localhost:8000
