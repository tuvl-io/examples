# Content Moderation Pipeline — environment template.
# Copy to .env and fill in real values. .env is git-ignored; never commit secrets.

# ── PostgreSQL (plain Postgres, no pgvector) ──────────────────────────────
# Create the database first:  CREATE DATABASE tuvl_moderation;
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tuvl_moderation
POSTGRES_USER=tuvl
POSTGRES_PASSWORD=your-postgres-password

# ── LLM — Google Gemini via LiteLLM (gemini/gemini-3.1-flash-lite) ─────────
# Required by the `classify` Agent step (llms/default.yaml → gemini/gemini-3.1-flash-lite).
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_CLOUD_PROJECT=712961387019

# ── Violation notification webhook ────────────────────────────────────────
# Where the `notify` APICall POSTs violation summaries. Resolved at runtime by
# nodes/prepare_audit.py; defaults to httpbin so the demo runs with no setup.
MODERATION_WEBHOOK_URL=https://httpbin.org/post

# ── Production HITL only (tuvl run) ───────────────────────────────────────
# The group-gated resume needs real Biscuit tokens, which require a signing key
# in production mode. Generate with `tuvl keys generate`. `tuvl dev` mints an
# ephemeral key automatically, so this is NOT needed for the dev-mode demo.
# TUVL_BISCUIT_PRIVATE_KEY=
