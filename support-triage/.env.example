# Safe to commit — placeholder values only.
# Copy to .env and fill in real values. .env is git-ignored; never commit secrets.

# --- PostgreSQL (database: tuvl_support) ---
# The datasource (datasources/postgres.yaml) reads these individual vars.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tuvl_support
POSTGRES_USER=tuvl
POSTGRES_PASSWORD=your-postgres-password

# --- LLM ---
# Default is a LOCAL Ollama model (llms/default.yaml → ollama_chat/llama3.1:latest)
# — no key required. Just run Ollama and pull the model:
#   ollama serve
#   ollama pull llama3.1:latest
#
# To use a hosted model instead, edit llms/default.yaml (see the commented
# Gemini block there) and set the matching key here:
# GEMINI_API_KEY=your-gemini-api-key

# --- Production (only needed by `tuvl run` / a shipped container) ---
# Generate with: tuvl keys generate
# TUVL_BISCUIT_PRIVATE_KEY=your-biscuit-private-key

# --- Optional ---
TUVL_TELEMETRY_ENABLED=false
