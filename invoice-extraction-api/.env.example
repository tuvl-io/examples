# Safe to commit — placeholder values only.
# Copy to .env and fill in real values. .env is git-ignored; never commit secrets.

# --- PostgreSQL (database: tuvl_invoices) ---
# The datasource (datasources/postgres.yaml) reads these individual vars.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tuvl_invoices
POSTGRES_USER=tuvl
POSTGRES_PASSWORD=your-postgres-password

# LLM — Google Gemini via LiteLLM (gemini/gemini-3.1-flash-lite)
# Used by the `extract` Agent step (llms/default.yaml → gemini/gemini-3.1-flash-lite).
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_CLOUD_PROJECT=712961387019

# --- Optional ---
# Set true to emit OpenTelemetry spans; verifies vendor_tax_id is masked
# ("*****") in span context snapshots (acceptance criterion 5).
TUVL_TELEMETRY_ENABLED=false

# Judge model for `tuvl test` LLM-as-a-Judge evaluations (defaults per test file).
# TUVL_TEST_JUDGE=gemini/gemini-3.1-flash-lite
