          "expires": "48h",
          "route_on": "upheld",
          "form": [],
          "show": [
            "findings"
          ]
        }
      ],
      "tool_approvals": [],
      "examples": [
        {
          "name": "a-missing-clinical-note-is-a-warning",
          "input": {
            "member_ref": "M-100",
            "procedure_code": "MRI-LUMBAR",
            "diagnosis_code": "M54.5"
          },
          "end": "warn"
        },
        {
          "name": "a-procedure-with-no-active-policy-is-not-found",
          "input": {
            "member_ref": "M-100",
            "procedure_code": "CT-HEAD",
            "diagnosis_code": "R51"
          },
          "end": "no_policy"
        },
        {
          "name": "a-request-that-meets-every-rule-passes",
          "input": {
            "member_ref": "M-100",
            "procedure_code": "MRI-LUMBAR",
            "diagnosis_code": "M54.5"
          },
          "end": "default"
        },
        {
          "name": "a-reviewer-who-overrides-the-block-ends-it-as-overridden",
          "input": {
            "member_ref": "M-100",
            "procedure_code": "MRI-LUMBAR",
            "diagnosis_code": "M54.5"
          },
          "end": "overridden"
